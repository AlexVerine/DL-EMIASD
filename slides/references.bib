	publisher = {Springer Berlin Heidelberg},
	author = {Altun, Yasemin and Smola, Alex},
	editor = {Hutchison, David and Kanade, Takeo and Kittler, Josef and Kleinberg, Jon M. and Mattern, Friedemann and Mitchell, John C. and Naor, Moni and Nierstrasz, Oscar and Pandu Rangan, C. and Steffen, Bernhard and Sudan, Madhu and Terzopoulos, Demetri and Tygar, Dough and Vardi, Moshe Y. and Weikum, Gerhard and Lugosi, Gábor and Simon, Hans Ulrich},
	year = {2006},
	doi = {10.1007/11776420_13},
	note = {Series Title: Lecture Notes in Computer Science},
	pages = {139--153},
}


	doi = {10.7153/mia-2020-23-95},
	abstract = {Lower and upper bounds \$B\_a(x)\$ on the incomplete gamma function \${\textbackslash}Gamma(a,x)\$ are given for all real \$a\$ and all real \$x{\textgreater}0\$. These bounds \$B\_a(x)\$ are exact in the sense that \$B\_a(x){\textbackslash}underset\{x{\textbackslash}downarrow0\}{\textbackslash}sim{\textbackslash}Gamma(a,x)\$ and \$B\_a(x){\textbackslash}underset\{x{\textbackslash}to{\textbackslash}infty\}{\textbackslash}sim{\textbackslash}Gamma(a,x)\$. Moreover, the relative errors of these bounds are rather small for other values of \$x\$, away from \$0\$ and \${\textbackslash}infty\$.},

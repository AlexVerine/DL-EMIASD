}

@inproceedings{koehler_representational_2021,
	title = {Representational aspects of depth and conditioning in normalizing flows},
	url = {https://proceedings.mlr.press/v139/koehler21a.html},
	abstract = {Normalizing flows are among the most popular paradigms in generative modeling, especially for images, primarily because we can efficiently evaluate the likelihood of a data point. This is desirable both for evaluating the fit of a model, and for ease of training, as maximizing the likelihood can be done by gradient descent. However, training normalizing flows comes with difficulties as well: models which produce good samples typically need to be extremely deep – which comes with accompanying vanishing/exploding gradient problems. A very related problem is that they are often poorly {\textbackslash}emph\{conditioned\}: since they are parametrized as invertible maps from \${\textbackslash}mathbb\{R\}{\textasciicircum}d {\textbackslash}to {\textbackslash}mathbb\{R\}{\textasciicircum}d\$, and typical training data like images intuitively is lower-dimensional, the learned maps often have Jacobians that are close to being singular. In our paper, we tackle representational aspects around depth and conditioning of normalizing flows: both for general invertible architectures, and for a particular common architecture, affine couplings. We prove that \${\textbackslash}Theta(1)\$ affine coupling layers suffice to exactly represent a permutation or \$1 {\textbackslash}times 1\$ convolution, as used in GLOW, showing that representationally the choice of partition is not a bottleneck for depth. We also show that shallow affine coupling networks are universal approximators in Wasserstein distance if ill-conditioning is allowed, and experimentally investigate related phenomena involving padding. Finally, we show a depth lower bound for general flow architectures with few neurons per layer and bounded Lipschitz constant.},
	language = {en},
	urldate = {2022-06-24},
	booktitle = {Proceedings of the 38th {International} {Conference} on {Machine} {Learning}},
	publisher = {PMLR},
	author = {Koehler, Frederic and Mehta, Viraj and Risteski, Andrej},
	month = jul,
	year = {2021},
	note = {ISSN: 2640-3498},
	pages = {5628--5636},
}

@inproceedings{kong_expressive_2020,
	title = {The {Expressive} {Power} of a {Class} of {Normalizing} {Flow} {Models}},
	url = {https://proceedings.mlr.press/v108/kong20a.html},
	abstract = {Normalizing flows have received a great deal of recent attention as they allow flexible generative modeling as well as easy likelihood computation. While a wide variety of flow models have been proposed, there is little formal understanding of the representation power of these models. In this work, we study some basic normalizing flows and rigorously establish bounds on their expressive power. Our results indicate that while these flows are highly expressive in one dimension, in higher dimensions their representation power may be limited, especially when the flows have moderate depth.},
